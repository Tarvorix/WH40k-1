            },
            "timing": "start_of_defender_command_phase",
            "branches": [
              {
                "if": "defender_controls_control_node",
                "per_loader_effect": {
                  "Attacker_vp_delta": -10,
                  "Defender_vp_delta": 10
                }
              },
              {
                "if": "defender_does_not_control_control_node",
                "per_loader_effect": {
                  "Attacker_vp_delta": -5,
