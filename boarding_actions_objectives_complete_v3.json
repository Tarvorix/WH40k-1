{
  "schema_version": "2.0.0",
  "title": "Boarding Actions Mission Objectives Complete v3",
  "source_basis": {
    "primary_docs": [
      "boarding_actions_missions_complete_v3.md",
      "boarding_patrol_complete_v3.md"
    ],
    "notes": [
      "Refreshed scoring/objective layer aligned to the Wahapedia Boarding Action Rules page.",
      "Where a mission depends on map-defined labels (A/B/Critical/Generator/Terminal/etc.), the canonical labels are cross-referenced in boarding_actions_maps_complete_v3.json."
    ]
  },
  "global_rules": {
    "mission_vp_cap": 90,
    "battle_ready_bonus_vp": 10,
    "battle_rounds": 5,
    "round5_second_player_timing_default": "end_of_turn",
    "common_progressive_template": {
      "id": "ba_common_control_3x5",
      "description": "Common Boarding Actions progressive scoring pattern.",
      "rounds": [
        2,
        3,
        4
      ],
      "timing": "end_of_command_phase",
      "per_satisfied_condition_vp": 5,
      "default_conditions": [
        "control_one_or_more_objective_markers",
        "control_two_or_more_objective_markers",
        "control_more_objective_markers_than_opponent"
      ],
      "round5": {
        "first_player_timing": "end_of_command_phase",
        "second_player_timing": "end_of_turn"
      }
    }
  },
